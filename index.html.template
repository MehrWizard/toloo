<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Toloo Protocol Benchmarks</title>
<style>
  :root{
    --bg:#18181e;
    --surface:#23232e;
    --card:#2a2a3a;
    --line:#383850;
    --text:#f5f5f8;
    --muted:#a0a0b0;
    --green:#3dba6e;
    --amber:#e0a020;
    --red:#e05050;
    --blue:#4a9cf0;
    --mono:'JetBrains Mono', ui-monospace, monospace;
    --sans:system-ui, -apple-system, Segoe UI, sans-serif;
    --r:10px;
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:var(--sans);background:var(--bg);color:var(--text);line-height:1.55;
    -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
  }
  .wrap{max-width:1280px;margin:0 auto;padding:2.5rem 1.5rem 5rem;display:grid;grid-template-columns:1fr 400px;gap:2.5rem;align-items:start}
  @media(max-width:1050px){.wrap{grid-template-columns:1fr;gap:2rem;padding:1.5rem 1rem 3rem}}

  /* Header */
  header{grid-column:1/-1;margin-bottom:.5rem}
  h1{font-size:1.65rem;font-weight:700;letter-spacing:-0.03em;line-height:1.15;margin-bottom:.35rem;color:var(--text)}
  .subtitle{font-size:.85rem;color:var(--muted);letter-spacing:.01em}

  /* Cards */
  .card{
    background:var(--card);border:1px solid var(--line);border-radius:var(--r);
    padding:1.25rem 1.25rem 1rem;box-shadow:0 1px 0 rgba(255,255,255,.03);
  }
  .card h2{
    font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em;
    color:var(--muted);margin-bottom:.9rem;border-bottom:1px solid var(--line);padding-bottom:.35rem;
  }
  .card p.sub{font-size:.72rem;color:var(--muted);margin-bottom:1rem;line-height:1.35}

  /* Section spacing */
  .section{margin-bottom:1.5rem}
  .full{grid-column:1/-1}

  /* Protocol comparison - responsive 2-column grid */
  .proto-grid{
    display:grid;
    grid-template-columns:1fr;
    gap:1.5rem;
  }
  @media(min-width:900px){
    .proto-grid{
      grid-template-columns:1fr 1fr;
    }
  }
  .proto-card{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--r);
    padding:1rem;
  }
  .proto-card h3{
    font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;
    color:var(--muted);margin-bottom:.75rem;padding-bottom:.35rem;border-bottom:1px solid var(--line);
  }
  .proto-rows{display:flex;flex-direction:column;gap:.35rem}
  .proto-row{
    display:flex;align-items:center;gap:.6rem;height:24px;
  }
  .proto-label{
    width:100px;font-family:var(--mono);font-size:.7rem;color:var(--text);
    text-align:right;flex-shrink:0;padding-right:.4rem;letter-spacing:.01em;
  }
  .proto-bar{
    flex:1;height:14px;background:rgba(255,255,255,.04);border:1px solid var(--line);
    border-radius:4px;overflow:hidden;position:relative;
  }
  .proto-fill{
    height:100%;border-radius:3px;display:flex;align-items:center;padding-left:.3rem;
    font-family:var(--mono);font-size:.55rem;font-weight:600;color:#0d0d12;white-space:nowrap;
  }
  .proto-val{
    width:90px;font-family:var(--mono);font-size:.7rem;color:var(--text);
    text-align:right;flex-shrink:0;
  }

  /* Simulation cards */
  .sim-card{
    background:var(--surface);border:1px solid var(--line);border-radius:var(--r);
    padding:1.1rem 1.1rem 1rem;margin-bottom:1.1rem;box-shadow:0 1px 0 rgba(255,255,255,.02);
  }
  .sim-card h3{
    font-size:.85rem;font-weight:600;color:var(--text);margin-bottom:.9rem;letter-spacing:-.01em;
  }
  .sim-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-bottom:.8rem}
  .sim-grid .item .label{font-size:.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.2rem}
  .sim-grid .item .num{font-family:var(--mono);font-size:1.2rem;font-weight:700;color:var(--text);line-height:1.2}
  .sim-grid .item .note{font-size:.7rem;color:var(--muted);margin-top:.2rem;line-height:1.3}
  .sim-grid .item .big-num{font-family:var(--mono);font-size:1.45rem;font-weight:700;line-height:1.15}

  /* Tables */
  .table{width:100%;font-size:.72rem;border-collapse:collapse}
  .table th{text-align:left;color:var(--muted);font-size:.6rem;text-transform:uppercase;letter-spacing:.08em;padding:.35rem .5rem;border-bottom:1px solid var(--line);font-weight:600}
  .table td{padding:.35rem .5rem;border-bottom:1px solid rgba(255,255,255,.04);font-family:var(--mono);text-align:right;color:var(--text);white-space:nowrap}
  .table td:first-child{text-align:left;color:var(--text);font-family:var(--sans);font-weight:500}

  /* Cross-platform chart - CSS-based static bars */
  .chart-box{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:1rem}
  .chart-title{font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:.75rem}
  .chart-bars{display:flex;flex-direction:column;gap:.75rem}
  .chart-group{display:flex;flex-direction:column;gap:.35rem}
  .chart-group-label{font-size:.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
  .chart-platform-row{display:flex;align-items:center;gap:.5rem;height:22px}
  .chart-platform-label{width:100px;font-family:var(--mono);font-size:.65rem;color:var(--text);text-align:right;flex-shrink:0}
  .chart-platform-bar{flex:1;height:16px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:4px;overflow:hidden;position:relative}
  .chart-platform-fill{height:100%;border-radius:3px;transition:width .3s ease}
  .chart-platform-val{width:80px;font-family:var(--mono);font-size:.65rem;color:var(--text);text-align:right;flex-shrink:0}
  .chart-legend{display:flex;gap:1rem;margin-top:.75rem;font-size:.65rem}
  .chart-legend-item{display:flex;align-items:center;gap:.35rem}
  .chart-legend-color{width:10px;height:10px;border-radius:2px}

  /* Small utilities */
  .text-green{color:var(--green)}
  .text-amber{color:var(--amber)}
  .text-red{color:var(--red)}
  .meta-bar{grid-column:1/-1;display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:1rem;padding-top:1rem;border-top:1px solid var(--line);font-size:.7rem;color:var(--muted)}
  .meta-item{font-family:var(--mono)}
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>Toloo Benchmarks</h1>
  <p class="subtitle">Cross-platform microbenchmarks · 6 categories · 22 benchmarks</p>
</header>

<div class="meta-bar">
  <span class="meta-item">Commit: %{COMMIT_SHORT}%</span>
  <span class="meta-item">Branch: %{BRANCH}%</span>
  <span class="meta-item">Date: %{BUILD_DATE}%</span>
  <span class="meta-item">Runner: %{RUNNER_INFO}%</span>
</div>

<!-- FULL WIDTH: Protocol comparison - 2 column grid -->
<section class="section full">
  <div class="card">
    <h2>Toloo vs. Other Protocols</h2>
    <p class="sub">Per-message latency (lower = better). Measured Toloo vs reference estimates for IRC/XMPP/Matrix.</p>
    <div class="proto-grid">
      <!-- Column 1: Canonical Encode, Envelope Verify, Parse Envelope -->
      <div class="proto-card">
        <h3>Encoding & Parsing</h3>
        <div class="proto-rows">
          <div class="proto-row">
            <span class="proto-label">Canonical Encode</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_CANONICAL_TOLOO_PCT}%;background:var(--green)"></div>
            </div>
            <span class="proto-val">%{PROTO_CANONICAL_TOLOO_NS} ns</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">IRC</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_CANONICAL_IRC_PCT}%;background:var(--amber)"></div>
            </div>
            <span class="proto-val">%{PROTO_CANONICAL_IRC_RATIO}x slower</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">XMPP</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_CANONICAL_XMPP_PCT}%;background:var(--red)"></div>
            </div>
            <span class="proto-val">%{PROTO_CANONICAL_XMPP_RATIO}x slower</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">Matrix</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_CANONICAL_MATRIX_PCT}%;background:var(--red)"></div>
            </div>
            <span class="proto-val">%{PROTO_CANONICAL_MATRIX_RATIO}x slower</span>
          </div>

          <div class="proto-row" style="margin-top:.5rem">
            <span class="proto-label">Envelope Verify</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_VERIFY_TOLOO_PCT}%;background:var(--green)"></div>
            </div>
            <span class="proto-val">%{PROTO_VERIFY_TOLOO_NS} ns</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">IRC</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_VERIFY_IRC_PCT}%;background:var(--amber)"></div>
            </div>
            <span class="proto-val">%{PROTO_VERIFY_IRC_RATIO}x slower</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">XMPP</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_VERIFY_XMPP_PCT}%;background:var(--red)"></div>
            </div>
            <span class="proto-val">%{PROTO_VERIFY_XMPP_RATIO}x slower</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">Matrix</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_VERIFY_MATRIX_PCT}%;background:var(--red)"></div>
            </div>
            <span class="proto-val">%{PROTO_VERIFY_MATRIX_RATIO}x slower</span>
          </div>

          <div class="proto-row" style="margin-top:.5rem">
            <span class="proto-label">Parse Envelope</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_PARSE_TOLOO_PCT}%;background:var(--green)"></div>
            </div>
            <span class="proto-val">%{PROTO_PARSE_TOLOO_NS} ns</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">IRC</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_PARSE_IRC_PCT}%;background:var(--amber)"></div>
            </div>
            <span class="proto-val">%{PROTO_PARSE_IRC_RATIO}x slower</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">XMPP</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_PARSE_XMPP_PCT}%;background:var(--red)"></div>
            </div>
            <span class="proto-val">%{PROTO_PARSE_XMPP_RATIO}x slower</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">Matrix</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_PARSE_MATRIX_PCT}%;background:var(--red)"></div>
            </div>
            <span class="proto-val">%{PROTO_PARSE_MATRIX_RATIO}x slower</span>
          </div>
        </div>
      </div>

      <!-- Column 2: Event Build, Pool Query, Crypto -->
      <div class="proto-card">
        <h3>Event Processing & Crypto</h3>
        <div class="proto-rows">
          <div class="proto-row">
            <span class="proto-label">Event Build</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_BUILD_TOLOO_PCT}%;background:var(--green)"></div>
            </div>
            <span class="proto-val">%{PROTO_BUILD_TOLOO_NS} ns</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">IRC</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_BUILD_IRC_PCT}%;background:var(--amber)"></div>
            </div>
            <span class="proto-val">%{PROTO_BUILD_IRC_RATIO}x slower</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">XMPP</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_BUILD_XMPP_PCT}%;background:var(--red)"></div>
            </div>
            <span class="proto-val">%{PROTO_BUILD_XMPP_RATIO}x slower</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">Matrix</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_BUILD_MATRIX_PCT}%;background:var(--red)"></div>
            </div>
            <span class="proto-val">%{PROTO_BUILD_MATRIX_RATIO}x slower</span>
          </div>

          <div class="proto-row" style="margin-top:.5rem">
            <span class="proto-label">Pool Query (1k)</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_POOL_TOLOO_PCT}%;background:var(--green)"></div>
            </div>
            <span class="proto-val">%{PROTO_POOL_TOLOO_NS} ns</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">IRC</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_POOL_IRC_PCT}%;background:var(--amber)"></div>
            </div>
            <span class="proto-val">%{PROTO_POOL_IRC_RATIO}x slower</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">XMPP</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_POOL_XMPP_PCT}%;background:var(--red)"></div>
            </div>
            <span class="proto-val">%{PROTO_POOL_XMPP_RATIO}x slower</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">Matrix</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_POOL_MATRIX_PCT}%;background:var(--red)"></div>
            </div>
            <span class="proto-val">%{PROTO_POOL_MATRIX_RATIO}x slower</span>
          </div>

          <div class="proto-row" style="margin-top:.5rem">
            <span class="proto-label">Crypto (ed25519)</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_CRYPTO_TOLOO_PCT}%;background:var(--green)"></div>
            </div>
            <span class="proto-val">%{PROTO_CRYPTO_TOLOO_NS} ns</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">IRC</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_CRYPTO_IRC_PCT}%;background:var(--amber)"></div>
            </div>
            <span class="proto-val">%{PROTO_CRYPTO_IRC_RATIO}x slower</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">XMPP</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_CRYPTO_XMPP_PCT}%;background:var(--red)"></div>
            </div>
            <span class="proto-val">%{PROTO_CRYPTO_XMPP_RATIO}x slower</span>
          </div>
          <div class="proto-row" style="opacity:.82">
            <span class="proto-label">Matrix</span>
            <div class="proto-bar">
              <div class="proto-fill" style="width:%{PROTO_CRYPTO_MATRIX_PCT}%;background:var(--red)"></div>
            </div>
            <span class="proto-val">%{PROTO_CRYPTO_MATRIX_RATIO}x slower</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- LEFT: Cross-Platform Latency (CSS-based static chart) -->
<div>
  <section class="section">
    <div class="card">
      <h2>Cross-Platform Latency</h2>
      <p class="sub">Mean latency (ns) per platform across 6 benchmark categories. Measured on GitHub-hosted runners.</p>
      <div class="chart-box">
        <div class="chart-bars" id="platform-chart">
          <!-- Populated by template -->
%{PLATFORM_CHART_ROWS}%
        </div>
        <div class="chart-legend">
          <div class="chart-legend-item"><span class="chart-legend-color" style="background:#4a9cf0"></span>linux-x86</div>
          <div class="chart-legend-item"><span class="chart-legend-color" style="background:#3dba6e"></span>linux-arm</div>
          <div class="chart-legend-item"><span class="chart-legend-color" style="background:#e0a020"></span>windows</div>
          <div class="chart-legend-item"><span class="chart-legend-color" style="background:#e05050"></span>macos-x86</div>
          <div class="chart-legend-item"><span class="chart-legend-color" style="background:#8b6fd0"></span>macos-arm</div>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- RIGHT: Simulation + Capacity + Key Results -->
<div>

  <section class="section">
    <div class="sim-card">
      <h3>Real-World Messaging Simulation</h3>
      <div class="sim-grid">
        <div class="item">
          <div class="label">Background Load</div>
          <div class="num">%{SIM_BG_LOAD}% msg/s</div>
          <div class="note">Modeled: 10 rooms × 1k users @ 0.02 msg/s + 1k active @ 0.1 msg/s</div>
        </div>
        <div class="item">
          <div class="label">Single Thread</div>
          <div class="num text-green">~%{SIM_SINGLE_THREAD}% msg/s</div>
          <div class="note">Measured: encode + verify + parse + build + pool + crypto</div>
        </div>
      </div>
      <div class="sim-grid">
        <div class="item">
          <div class="label">Steady Headroom</div>
          <div class="big-num text-green">%{SIM_STEADY}%×</div>
        </div>
        <div class="item">
          <div class="label">Burst Headroom (50×)</div>
          <div class="big-num text-red">%{SIM_BURST}%×</div>
          <div class="note">Requires horizontal scale or queueing</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="sim-card">
      <h3>Capacity Planning (Measured Scaling)</h3>
      <table class="table">
        <thead><tr><th>Config</th><th>Throughput</th><th>Users (0.1 msg/s)</th><th>Rooms</th></tr></thead>
        <tbody>
          <tr><td>1 thread (ubuntu-slim, 1 vCPU)</td><td>%{CAP_1_THREAD}% msg/s</td><td>%{CAP_1_USERS}%</td><td>10</td></tr>
          <tr><td>4 threads (ubuntu-24.04, 4 vCPU)</td><td>%{CAP_4_THREAD}% msg/s</td><td>%{CAP_4_USERS}%</td><td>40</td></tr>
          <tr><td>16 threads (sharded, estimated)</td><td>%{CAP_16_THREAD}% msg/s</td><td>%{CAP_16_USERS}%</td><td>160</td></tr>
          <tr><td>64 threads (NUMA, estimated)</td><td>%{CAP_64_THREAD}% msg/s</td><td>%{CAP_64_USERS}%</td><td>640</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="sim-card">
      <h3>Key Results (linux-x86, 1 vCPU)</h3>
%{KEY_RESULTS_ROWS}%
    </div>
  </section>

</div>

</div>
</body>
</html>