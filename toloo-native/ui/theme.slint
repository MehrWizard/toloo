export global Theme {
    out property <color> bg: #0d0908;
    out property <color> surface: #191210;
    out property <color> surface-2: #221917;
    out property <color> border: #382520;
    out property <color> accent: #f05228;
    out property <color> accent-strong: #d43e17;
    out property <color> text: #f0ebe6;
    out property <color> text-2: #a8958e;
    out property <color> muted: #6b5048;
    out property <color> success: #5cbe8a;
    out property <color> warn: #e09a3a;
    out property <color> danger: #e05b5b;

    out property <length> radius: 12px;
    out property <length> radius-sm: 7px;
    out property <length> sidebar-width: 300px;
    out property <length> rail-width: 280px;
    out property <length> header-height: 54px;
    out property <length> touch-target: 44px;

    out property <length> font-xs: 9px;
    out property <length> font-sm: 11px;
    out property <length> font-ui: 14px;
    out property <length> font-title: 18px;
    out property <length> font-brand: 19px;

    out property <[color]> avatars: [
        #7b4a3a,
        #4e5d4b,
        #5c476f,
        #7a5a35,
        #3f5e69,
        #6d3f4e,
        #53633a,
        #4a4c70
    ];
}
