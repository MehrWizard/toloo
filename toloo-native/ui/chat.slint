import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppIcon, Avatar, DropdownItem, DropdownSeparator, IconButton, MessageGutter, TextField } from "components.slint";
import { MessageRow } from "models.slint";

export component ChatPane inherits Rectangle {
    in property <[MessageRow]> messages;
    in property <string> room-name;
    in property <string> room-id;
    in property <string> room-id-full;
    in property <string> room-initial: "?";
    in property <string> room-avatar-path;
    in property <int> room-avatar-palette: 0;
    in property <string> members-label: "";
    in property <string> status: "";
    in property <bool> has-room: false;
    in property <bool> show-back: false;
    in property <bool> room-has-key: false;
    in property <bool> rtl: false;
    in-out property <string> message-input: "";
    callback back();
    callback sync-room();
    callback share-room();
    callback export-room();
    callback rename-room(string, string);
    callback leave-room(string);
    callback remove-room(string);
    callback send-message(string);
    callback open-settings();
    callback copy-text(string);
    callback flag-message(string, string, string);
    callback block-node(string, string, string);
    callback attest-node(string, string);
    callback delete-message(string, string);
    callback copy-selected([string]);
    callback delete-selected([string]);

    private property <string> menu-eid;
    private property <string> menu-author;
    private property <string> menu-author-id;
    private property <string> menu-body;
    private property <bool> menu-mine: false;
    private property <length> menu-x: 0px;
    private property <length> menu-y: 0px;
    private property <length> menu-width: 224px;
    private property <length> menu-height: root.menu-mine ? 261px : 216px;
    private property <length> room-menu-x: 0px;
    private property <length> room-menu-y: 0px;
    private property <length> room-menu-width: 224px;
    private property <length> room-menu-height: 303px;
    in-out property <[string]> selected-eids: [];
    private property <bool> selection-dragging: false;
    private property <length> selection-y: 0px;
    private property <int> selection-last-index: -1;
    private property <length> emoji-picker-x: 0px;
    private property <length> emoji-picker-y: 0px;
    private property <length> emoji-picker-width: 340px;
    private property <length> emoji-picker-height: 176px;
    private property <[string]> emojis: [
        "😀", "😂", "😊", "😍", "🤔", "😎", "😢", "😡",
        "👍", "👎", "🙏", "👏", "💪", "🤝", "👋", "❤️",
        "🔥", "✨", "🎉", "💯", "🌙", "☀️", "🌱", "🍀",
        "🍕", "☕", "🎵", "📎", "✅", "❌", "🔒", "🔗"
    ];

    public function toggle-message(eid: string) {
        let index = root.selected-eids.index-of(eid);
        if (index >= 0) {
            root.selected-eids.remove(index);
        } else {
            root.selected-eids.push(eid);
        }
    }

    public function begin-selection(index: int, eid: string) {
        root.selection-last-index = index;
        root.selection-dragging = true;
        root.toggle-message(eid);
    }

    public function hit-selection(index: int, eid: string) {
        if (root.selection-dragging && root.selection-last-index != index) {
            root.selection-last-index = index;
            root.toggle-message(eid);
        }
    }

    public function clear-selected() {
        root.selected-eids = [];
        root.selection-dragging = false;
    }

    changed room-id-full => {
        root.clear-selected();
    }

    background: Theme.bg;
    height: 100%;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: Theme.header-height;
            background: Theme.bg;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                cross-axis-alignment: center;

                if root.show-back : IconButton {
                    icon: @image-url("../../design/icons/back.svg");
                    tint: Theme.text-2;
                    layout-order: root.rtl ? 10 : 0;
                    clicked => { root.back(); }
                }
                if root.has-room : Avatar {
                    avatar-size: 34px;
                    label: root.room-initial;
                    path: root.room-avatar-path;
                    palette: root.room-avatar-palette;
                }
                if root.has-room : VerticalLayout {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    spacing: 1px;
                    Text {
                        text: root.room-name;
                        color: Theme.text;
                        font-size: Theme.font-ui;
                        font-weight: 650;
                        horizontal-alignment: root.rtl ? right : left;
                        overflow: elide;
                    }
                    Text {
                        text: root.room-id == "" ? root.members-label
                            : root.members-label == "" ? root.room-id
                            : root.room-id + " · " + root.members-label;
                        color: Theme.muted;
                        font-size: Theme.font-xs;
                        font-family: "monospace";
                        horizontal-alignment: root.rtl ? right : left;
                        overflow: elide;
                    }
                }
                if !root.has-room : Text {
                    text: "Select a room";
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: 650;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.has-room && !root.show-back : IconButton {
                    icon: @image-url("../../design/icons/sync.svg");
                    tint: Theme.text-2;
                    clicked => { root.sync-room(); }
                }
                if root.has-room && !root.show-back : IconButton {
                    icon: @image-url("../../design/icons/share.svg");
                    tint: Theme.text-2;
                    clicked => { root.share-room(); }
                }
                if root.has-room && !root.show-back : IconButton {
                    icon: @image-url("../../design/icons/export.svg");
                    tint: Theme.text-2;
                    clicked => { root.export-room(); }
                }
                if root.has-room : room-more := IconButton {
                    icon: @image-url("../../design/icons/more.svg");
                    tint: Theme.text-2;
                    clicked => {
                        root.room-menu-x = room-more.absolute-position.x - root.absolute-position.x
                            + (root.rtl ? 0px : room-more.width - root.room-menu-width);
                        root.room-menu-y = room-more.absolute-position.y - root.absolute-position.y
                            + room-more.height + 2px;
                        room-actions-menu.show();
                    }
                }
                IconButton {
                    icon: @image-url("../../design/icons/settings.svg");
                    tint: Theme.muted;
                    clicked => { root.open-settings(); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }

        if !root.has-room : Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: center;
                cross-axis-alignment: center;
                spacing: 10px;
                AppIcon {
                    source: @image-url("../../design/icons/user.svg");
                    icon-size: 48px;
                    tint: Theme.border;
                }
                Text {
                    text: "Select a room to start chatting";
                    color: Theme.text-2;
                    font-size: Theme.font-ui;
                    horizontal-alignment: center;
                }
            }
        }

        if root.has-room : messages-scroll := ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            VerticalLayout {
                padding: 12px;
                spacing: 9px;

                if root.messages.length == 0 : Rectangle {
                    height: 170px;
                    Text {
                        text: "No messages yet.\nSay hello.";
                        color: Theme.muted;
                        font-size: Theme.font-ui;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                for message[index] in root.messages : HorizontalLayout {
                    spacing: 8px;
                    alignment: message.mine
                        ? (root.rtl ? start : end)
                        : (root.rtl ? end : start);

                    if !message.mine : MessageGutter {
                        label: message.author-initial;
                        path: message.grouped ? "" : message.avatar-path;
                        palette: message.avatar-palette;
                        selected: root.selected-eids.index-of(message.eid) >= 0;
                        selection-mode: root.selected-eids.length > 0;
                        long-pressed => { root.begin-selection(index, message.eid); }
                        toggle => { root.toggle-message(message.eid); }
                        drag(y) => { root.selection-y = y - root.absolute-position.y; }
                        released => { root.selection-dragging = false; }
                    }
                    VerticalLayout {
                        max-width: 520px;
                        spacing: 3px;
                        if !message.grouped && !message.mine : Text {
                            text: message.author;
                            color: Theme.muted;
                            font-size: Theme.font-xs;
                            font-family: "monospace";
                        }
                        message-bubble := Rectangle {
                            border-radius: Theme.radius;
                            background: message.mine ? Theme.bubble-mine : Theme.surface;
                            border-width: 1px;
                            border-color: root.selected-eids.index-of(message.eid) >= 0
                                ? Theme.accent
                                : message.mine ? Theme.bubble-mine-border : Theme.border;
                            selection-hit-timer := Timer {
                                interval: 30ms;
                                running: root.selection-dragging
                                    && root.selection-y >= message-bubble.absolute-position.y - root.absolute-position.y
                                    && root.selection-y < message-bubble.absolute-position.y - root.absolute-position.y + message-bubble.height;
                                triggered => {
                                    root.hit-selection(index, message.eid);
                                }
                            }
                            VerticalLayout {
                                padding: 9px;
                                spacing: 3px;
                                TextInput {
                                    text: message.body;
                                    read-only: true;
                                    single-line: false;
                                    color: Theme.text;
                                    font-size: Theme.font-ui;
                                    horizontal-alignment: root.rtl ? right : left;
                                    wrap: word-wrap;
                                    selection-background-color: Theme.accent;
                                    selection-foreground-color: #1a0d08;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    cross-axis-alignment: center;
                                    Rectangle { horizontal-stretch: 1; min-width: 1px; }
                                    Text {
                                        text: message.new-day ? message.day-label + " · " + message.clock : message.clock;
                                        color: Theme.muted;
                                        font-size: Theme.font-xs;
                                    }
                                    Text {
                                        text: message.status;
                                        color: message.status == "failed" ? Theme.danger
                                            : message.status == "sent" ? Theme.success : Theme.warn;
                                        font-size: Theme.font-xs;
                                    }
                                    message-more := IconButton {
                                        icon: @image-url("../../design/icons/more.svg");
                                        tint: Theme.muted;
                                        button-size: 22px;
                                        clicked => {
                                            root.menu-eid = message.eid;
                                            root.menu-author = message.author;
                                            root.menu-author-id = message.author-id;
                                            root.menu-body = message.body;
                                            root.menu-mine = message.mine;
                                            root.menu-x = message-more.absolute-position.x - root.absolute-position.x
                                                + (root.rtl ? 0px : message-more.width - root.menu-width);
                                            root.menu-y = message-more.absolute-position.y - root.absolute-position.y
                                                + message-more.height + 2px;
                                            message-menu.show();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if message.mine : MessageGutter {
                        label: message.author-initial;
                        path: message.grouped ? "" : message.avatar-path;
                        palette: message.avatar-palette;
                        selected: root.selected-eids.index-of(message.eid) >= 0;
                        selection-mode: root.selected-eids.length > 0;
                        long-pressed => { root.begin-selection(index, message.eid); }
                        toggle => { root.toggle-message(message.eid); }
                        drag(y) => { root.selection-y = y - root.absolute-position.y; }
                        released => { root.selection-dragging = false; }
                    }
                }
            }

            selection-scroll := Timer {
                interval: 60ms;
                running: root.selection-dragging
                    && (root.selection-y < 100px || root.selection-y > root.height - 80px);
                triggered => {
                    if (root.selection-y < 100px) {
                        messages-scroll.content-y = min(0px, messages-scroll.content-y + 24px);
                    } else {
                        messages-scroll.content-y = max(
                            messages-scroll.visible-height - messages-scroll.content-height,
                            messages-scroll.content-y - 24px
                        );
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }
        Rectangle {
            background: Theme.bg;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    emoji-button := IconButton {
                        icon: @image-url("../../design/icons/emoji.svg");
                        tint: Theme.text-2;
                        button-size: 40px;
                        layout-order: root.rtl ? 2 : 0;
                        clicked => {
                            root.emoji-picker-x = emoji-button.absolute-position.x - root.absolute-position.x;
                            root.emoji-picker-y = emoji-button.absolute-position.y - root.absolute-position.y
                                - root.emoji-picker-height - 6px;
                            emoji-picker.show();
                        }
                    }
                    TextField {
                        text <=> root.message-input;
                        placeholder: root.has-room ? "Message…" : "Select a room first";
                        enabled: root.has-room;
                        rtl: root.rtl;
                        layout-order: 1;
                        field-height: 40px;
                        accepted => {
                            if (root.has-room && root.message-input != "") {
                                root.send-message(root.message-input);
                                root.message-input = "";
                            }
                        }
                    }
                    Rectangle {
                        width: 44px;
                        height: 40px;
                        layout-order: root.rtl ? 0 : 2;
                        border-radius: Theme.radius-sm;
                        background: root.has-room && root.message-input != ""
                            ? Theme.accent : Theme.surface-2;
                        AppIcon {
                            source: @image-url("../../design/icons/send.svg");
                            width: 19px;
                            height: 19px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            tint: root.has-room && root.message-input != "" ? #1a0d08 : Theme.muted;
                        }
                        TouchArea {
                            enabled: root.has-room && root.message-input != "";
                            clicked => {
                                root.send-message(root.message-input);
                                root.message-input = "";
                            }
                        }
                    }
                }
            }
        }
    }

    if root.selected-eids.length > 0 : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: Theme.header-height;
        background: Theme.bg;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            cross-axis-alignment: center;

            IconButton {
                icon: @image-url("../../design/icons/close.svg");
                tint: Theme.text-2;
                clicked => { root.clear-selected(); }
            }
            Text {
                text: "\{root.selected-eids.length} selected";
                color: Theme.text;
                font-size: Theme.font-ui;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; min-width: 1px; }
            IconButton {
                icon: @image-url("../../design/icons/copy.svg");
                tint: Theme.text-2;
                clicked => {
                    root.copy-selected(root.selected-eids);
                    root.clear-selected();
                }
            }
            IconButton {
                icon: @image-url("../../design/icons/trash.svg");
                tint: Theme.danger;
                clicked => {
                    root.delete-selected(root.selected-eids);
                    root.clear-selected();
                }
            }
        }
        Rectangle {
            y: parent.height - 1px;
            width: 100%;
            height: 1px;
            background: Theme.border;
        }
    }

    message-menu := PopupWindow {
        width: root.menu-width;
        height: root.menu-height;
        x: root.menu-x;
        y: root.menu-y;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: Theme.surface;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000088;
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                DropdownItem {
                    icon: @image-url("../../design/icons/copy.svg");
                    label: "Copy message text";
                    clicked => {
                        message-menu.close();
                        root.copy-text(root.menu-body);
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/flag.svg");
                    label: "Flag as spam";
                    tint: Theme.warn;
                    clicked => {
                        message-menu.close();
                        root.flag-message(root.room-id-full, root.menu-eid, "spam");
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/block.svg");
                    label: "Block author";
                    tint: Theme.danger;
                    clicked => {
                        message-menu.close();
                        root.block-node(root.menu-author-id, "block", "");
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/check.svg");
                    label: "Attest +";
                    tint: Theme.success;
                    clicked => {
                        message-menu.close();
                        root.attest-node(root.menu-author-id, "positive");
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/close.svg");
                    label: "Attest −";
                    tint: Theme.danger;
                    clicked => {
                        message-menu.close();
                        root.attest-node(root.menu-author-id, "negative");
                    }
                }
                if root.menu-mine : DropdownSeparator {}
                if root.menu-mine : DropdownItem {
                    icon: @image-url("../../design/icons/trash.svg");
                    label: "Delete message";
                    tint: Theme.danger;
                    clicked => {
                        message-menu.close();
                        root.delete-message(root.room-id-full, root.menu-eid);
                    }
                }
            }
        }
    }

    room-actions-menu := PopupWindow {
        width: root.room-menu-width;
        height: root.room-menu-height;
        x: root.room-menu-x;
        y: root.room-menu-y;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: Theme.surface;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000088;
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                DropdownItem {
                    icon: @image-url("../../design/icons/edit.svg");
                    label: "Rename room";
                    enabled: root.room-has-key;
                    clicked => {
                        room-actions-menu.close();
                        root.rename-room(root.room-id-full, root.room-name);
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/sync.svg");
                    label: "Sync now";
                    clicked => {
                        room-actions-menu.close();
                        root.sync-room();
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/share.svg");
                    label: "Share invite";
                    clicked => {
                        room-actions-menu.close();
                        root.share-room();
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/export.svg");
                    label: "Export messages";
                    clicked => {
                        room-actions-menu.close();
                        root.export-room();
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/copy.svg");
                    label: "Copy room key";
                    clicked => {
                        room-actions-menu.close();
                        root.copy-text(root.room-id-full);
                    }
                }
                DropdownSeparator {}
                DropdownItem {
                    icon: @image-url("../../design/icons/logout.svg");
                    label: "Leave room";
                    tint: Theme.warn;
                    clicked => {
                        room-actions-menu.close();
                        root.leave-room(root.room-id-full);
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/trash.svg");
                    label: "Remove from this device";
                    tint: Theme.danger;
                    clicked => {
                        room-actions-menu.close();
                        root.remove-room(root.room-id-full);
                    }
                }
            }
        }
    }
    emoji-picker := PopupWindow {
        width: root.emoji-picker-width;
        height: root.emoji-picker-height;
        x: root.emoji-picker-x;
        y: root.emoji-picker-y;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: Theme.surface;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000088;
            drop-shadow-offset-y: 6px;

            FlexboxLayout {
                padding: 8px;
                spacing: 4px;
                flex-wrap: wrap;

                for emoji in root.emojis : Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: Theme.radius-sm;
                    background: touch.pressed ? Theme.surface-2 : transparent;
                    Text {
                        text: emoji;
                        font-size: 20px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    touch := TouchArea {
                        clicked => {
                            root.message-input = root.message-input + emoji;
                            emoji-picker.close();
                        }
                    }
                }
            }
        }
    }

}
