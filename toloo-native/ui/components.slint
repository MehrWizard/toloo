import { Theme } from "theme.slint";

export component AppIcon inherits Image {
    in property <length> icon-size: 18px;
    in property <brush> tint: Theme.text;
    width: icon-size;
    height: icon-size;
    colorize: tint;
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <brush> tint: Theme.text-2;
    in property <length> button-size: 36px;
    callback clicked();

    width: button-size;
    height: button-size;
    border-radius: Theme.radius-sm;
    background: touch.pressed ? Theme.surface-2 : transparent;

    AppIcon {
        source: root.icon;
        width: root.button-size * 0.5;
        height: root.button-size * 0.5;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        tint: root.tint;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: Theme.touch-target;
    border-radius: Theme.radius-sm;
    background: !root.enabled ? Theme.surface-2
        : touch.pressed ? Theme.accent-strong : Theme.accent;

    Text {
        text: root.text;
        color: root.enabled ? #1a0d08 : Theme.muted;
        font-size: Theme.font-ui;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <brush> tint: Theme.text;
    callback clicked();

    height: Theme.touch-target;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.pressed ? Theme.surface-2 : transparent;

    Text {
        text: root.text;
        color: root.tint;
        font-size: Theme.font-ui;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component Avatar inherits Rectangle {
    in property <string> label;
    in property <string> path;
    in property <int> palette: 0;
    in property <length> avatar-size: 40px;

    width: avatar-size;
    height: avatar-size;
    background: transparent;
    clip: false;

    Path {
        width: root.avatar-size * 0.72;
        height: root.avatar-size * 0.72;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: root.path;
        fill: Theme.avatar-palette[root.palette];
    }
}

export component MessageGutter inherits Rectangle {
    in property <string> label;
    in property <string> path;
    in property <int> palette: 0;
    in property <bool> selected: false;
    in property <bool> selection-mode: false;
    callback long-pressed();
    callback toggle();
    callback drag(length);
    callback released();

    width: 26px;
    height: 26px;
    background: transparent;

    if root.path != "" : Avatar {
        avatar-size: 26px;
        label: root.label;
        path: root.path;
        palette: root.palette;
    }

    if root.selection-mode : Rectangle {
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 9px;
        border-width: 2px;
        border-color: root.selected ? Theme.accent : Theme.text-2;
        background: root.selected ? Theme.accent : #00000066;
        AppIcon {
            source: @image-url("../../design/icons/check.svg");
            icon-size: 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            tint: root.selected ? Theme.accent-ink : Theme.text-2;
            visible: root.selected;
        }
    }

    touch := TouchArea {
        property <bool> dragging: false;
        property <bool> long-fired: false;
        property <length> start-y: 0px;

        timer := Timer {
            interval: 450ms;
            running: touch.pressed && !touch.dragging && !touch.long-fired;
            triggered => {
                touch.long-fired = true;
                touch.dragging = true;
                root.long-pressed();
            }
        }

        changed pressed => {
            if (touch.pressed) {
                touch.start-y = touch.mouse-y;
                touch.long-fired = false;
                touch.dragging = false;
            } else {
                touch.dragging = false;
                root.released();
            }
        }
        moved => {
            if (touch.pressed) {
                if (!touch.dragging
                    && (touch.mouse-y - touch.start-y > 10px
                        || touch.start-y - touch.mouse-y > 10px)) {
                    touch.dragging = true;
                }
                if (root.selection-mode) {
                    root.drag(touch.absolute-position.y + touch.mouse-y);
                }
            }
        }
        clicked => {
            if (!touch.long-fired && root.selection-mode) {
                root.toggle();
            }
            touch.long-fired = false;
        }
    }
}

export component DropdownItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <brush> tint: Theme.text;
    in property <bool> enabled: true;
    callback clicked();

    height: 40px;
    border-radius: Theme.radius-sm;
    background: touch.pressed ? Theme.surface-2 : transparent;
    opacity: root.enabled ? 1 : 0.45;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        cross-axis-alignment: center;
        AppIcon {
            source: root.icon;
            icon-size: 16px;
            tint: root.tint;
        }
        Text {
            text: root.label;
            color: root.tint;
            font-size: Theme.font-ui;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component DropdownSeparator inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> rtl: false;
    in property <length> field-height: 40px;
    callback edited();
    callback accepted();

    height: field-height;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.enabled ? Theme.border : Theme.surface-2;
    background: Theme.bg;

    TextInput {
        x: 11px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 22px;
        height: parent.height - 8px;
        text <=> root.text;
        enabled: root.enabled;
        color: Theme.text;
        font-size: Theme.font-ui;
        single-line: true;
        horizontal-alignment: root.rtl ? right : left;
        vertical-alignment: center;
        selection-background-color: Theme.accent;
        selection-foreground-color: #1a0d08;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
    if root.text == "" : Text {
        x: 11px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 22px;
        text: root.placeholder;
        color: Theme.muted;
        font-size: Theme.font-ui;
        horizontal-alignment: root.rtl ? right : left;
        vertical-alignment: center;
    }
}

export component FieldLabel inherits Text {
    height: 14px;
    color: Theme.muted;
    font-size: Theme.font-xs;
    letter-spacing: 1px;
    vertical-alignment: center;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component StatusPill inherits Rectangle {
    in property <string> label;
    in property <brush> dot: Theme.success;
    height: 24px;
    border-radius: 12px;
    background: Theme.surface-2;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 10px;
        spacing: 6px;
        cross-axis-alignment: center;
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.dot;
        }
        Text {
            text: root.label;
            color: Theme.text-2;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }
}

export component SheetHandle inherits Rectangle {
    width: 38px;
    height: 4px;
    border-radius: 2px;
    background: Theme.border;
}
