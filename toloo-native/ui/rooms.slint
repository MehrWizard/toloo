import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Avatar, Divider, DropdownItem, DropdownSeparator, IconButton, TextField } from "components.slint";
import { RoomRow } from "models.slint";

export component RoomsPane inherits Rectangle {
    in property <[RoomRow]> rooms;
    in property <string> identity-label;
    in property <string> identity-initial: "?";
    in property <string> identity-avatar-path;
    in property <int> identity-avatar-palette: 0;
    in property <string> status: "";
    in property <string> network-label: "No relays";
    in property <bool> compact: false;
    in property <bool> phone: false;
    in property <bool> rtl: false;
    in-out property <string> search: "";
    callback select-room(string);
    callback sync-room(string);
    callback share-room(string);
    callback export-room(string);
    callback rename-room(string, string);
    callback copy-text(string);
    callback leave-room(string);
    callback remove-room(string);
    callback add-room();
    callback import-room();
    callback open-settings();
    callback open-relays();
    callback search-changed(string);

    private property <string> menu-room-id;
    private property <string> menu-room-name;
    private property <bool> menu-has-key: false;
    private property <length> menu-x: 0px;
    private property <length> menu-y: 0px;
    private property <length> menu-width: 224px;
    private property <length> menu-height: 303px;

    background: Theme.surface;
    height: 100%;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: Theme.header-height;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 11px;
                padding-right: 8px;
                spacing: 9px;
                cross-axis-alignment: center;

                Avatar {
                    avatar-size: 36px;
                    label: root.identity-initial;
                    path: root.identity-avatar-path;
                    palette: root.identity-avatar-palette;
                    layout-order: root.rtl ? 4 : 0;
                    TouchArea {
                        clicked => { root.open-settings(); }
                    }
                }
                Text {
                    text: root.identity-label;
                    color: Theme.text;
                    font-size: Theme.font-ui;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 170px;
                    layout-order: root.rtl ? 3 : 1;
                    TouchArea {
                        clicked => { root.open-settings(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; min-width: 1px; layout-order: 2; }
                IconButton {
                    icon: @image-url("../../design/icons/inbox.svg");
                    tint: Theme.text-2;
                    layout-order: root.rtl ? 1 : 3;
                    clicked => { root.import-room(); }
                }
                IconButton {
                    icon: @image-url("../../design/icons/plus.svg");
                    tint: Theme.accent;
                    layout-order: root.rtl ? 0 : 4;
                    clicked => { root.add-room(); }
                }
            }
        }
        Divider {}

        Rectangle {
            height: 48px;
            background: Theme.surface;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 7px;
                padding-bottom: 7px;
                TextField {
                    text <=> root.search;
                    placeholder: "Search rooms…";
                    rtl: root.rtl;
                    field-height: 34px;
                    edited => { root.search-changed(root.search); }
                }
            }
        }
        Divider {}

        ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-off;
            VerticalLayout {
                spacing: 0px;

                if root.rooms.length == 0 : Rectangle {
                    height: 150px;
                    Text {
                        text: "No rooms yet.\nAdd a room with +.";
                        color: Theme.muted;
                        font-size: Theme.font-ui;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }

                for room in root.rooms : Rectangle {
                    height: 66px;
                    background: room.selected && !root.phone ? Theme.surface-2 : transparent;

                    if room.selected && !root.phone : Rectangle {
                        x: root.rtl ? parent.width - self.width : 0px;
                        width: 3px;
                        height: 100%;
                        background: Theme.accent;
                    }
                    HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 10px;
                        spacing: 10px;
                        cross-axis-alignment: center;

                        Avatar {
                            avatar-size: 40px;
                            label: room.initial;
                            path: room.avatar-path;
                            palette: room.avatar-palette;
                            layout-order: root.rtl ? 3 : 0;
                        }
                        VerticalLayout {
                            vertical-stretch: 1;
                            horizontal-stretch: 1;
                            layout-order: root.rtl ? 2 : 1;
                            spacing: 2px;
                            Text {
                                text: room.display-name;
                                color: Theme.text;
                                font-size: Theme.font-ui;
                                font-weight: 600;
                                horizontal-alignment: root.rtl ? right : left;
                                overflow: elide;
                            }
                            Text {
                                text: room.preview;
                                color: Theme.muted;
                                font-size: Theme.font-sm;
                                horizontal-alignment: root.rtl ? right : left;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            layout-order: root.rtl ? 1 : 2;
                            spacing: 4px;
                            cross-axis-alignment: center;
                            Text {
                                text: room.time-label;
                                color: Theme.muted;
                                font-size: Theme.font-xs;
                                horizontal-alignment: right;
                            }
                            if room.unread > 0 : Rectangle {
                                height: 16px;
                                width: room.unread < 10 ? 16px
                                    : room.unread < 100 ? 22px : 28px;
                                border-radius: 8px;
                                background: Theme.accent;
                                unread-text := Text {
                                    text: room.unread > 99 ? "99+" : "\{room.unread}";
                                    color: #fff;
                                    font-size: 9px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                            }
                        }
                        menu-button := IconButton {
                            icon: @image-url("../../design/icons/more.svg");
                            tint: Theme.muted;
                            button-size: 30px;
                            layout-order: root.rtl ? 0 : 3;
                            clicked => {
                                root.menu-room-id = room.room-id;
                                root.menu-room-name = room.display-name;
                                root.menu-has-key = room.has-key;
                                root.menu-x = menu-button.absolute-position.x - root.absolute-position.x
                                    + (root.rtl ? 0px : menu-button.width - root.menu-width);
                                root.menu-y = menu-button.absolute-position.y - root.absolute-position.y
                                    + menu-button.height + 2px;
                                room-menu.show();
                            }
                        }
                    }
                    TouchArea {
                        x: root.rtl ? 42px : 0px;
                        width: parent.width - 42px;
                        height: parent.height;
                        clicked => { root.select-room(room.room-id); }
                    }
                }
            }
        }
        Divider {}

        Rectangle {
            height: 44px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 11px;
                padding-right: 8px;
                spacing: 7px;
                cross-axis-alignment: center;
                Text {
                    text: root.network-label;
                    color: Theme.text-2;
                    font-size: Theme.font-sm;
                    vertical-alignment: center;
                    layout-order: root.rtl ? 2 : 0;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; min-width: 1px; layout-order: 1; }
                IconButton {
                    icon: @image-url("../../design/icons/relay.svg");
                    tint: Theme.muted;
                    layout-order: root.rtl ? 0 : 2;
                    clicked => { root.open-relays(); }
                }
            }
        }
    }

    room-menu := PopupWindow {
        width: root.menu-width;
        height: root.menu-height;
        x: root.menu-x;
        y: root.menu-y;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: Theme.surface;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000088;
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                DropdownItem {
                    icon: @image-url("../../design/icons/edit.svg");
                    label: "Rename room";
                    enabled: root.menu-has-key;
                    clicked => {
                        room-menu.close();
                        root.rename-room(root.menu-room-id, root.menu-room-name);
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/sync.svg");
                    label: "Sync now";
                    clicked => {
                        room-menu.close();
                        root.sync-room(root.menu-room-id);
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/share.svg");
                    label: "Share invite";
                    clicked => {
                        room-menu.close();
                        root.share-room(root.menu-room-id);
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/export.svg");
                    label: "Export messages";
                    clicked => {
                        room-menu.close();
                        root.export-room(root.menu-room-id);
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/copy.svg");
                    label: "Copy room key";
                    clicked => {
                        room-menu.close();
                        root.copy-text(root.menu-room-id);
                    }
                }
                DropdownSeparator {}
                DropdownItem {
                    icon: @image-url("../../design/icons/logout.svg");
                    label: "Leave room";
                    tint: Theme.warn;
                    clicked => {
                        room-menu.close();
                        root.leave-room(root.menu-room-id);
                    }
                }
                DropdownItem {
                    icon: @image-url("../../design/icons/trash.svg");
                    label: "Remove from this device";
                    tint: Theme.danger;
                    clicked => {
                        room-menu.close();
                        root.remove-room(root.menu-room-id);
                    }
                }
            }
        }
    }
}
