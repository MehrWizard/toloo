import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { BlockedRow, MessageRow, RelayRow, RoomRow } from "models.slint";
import { RoomsPane } from "rooms.slint";
import { ChatPane } from "chat.slint";
import { AddRoomSheet, AlertSheet, ExportSheet, ImportSheet, RenameSheet, SettingsSheet } from "sheets.slint";

export component AppWindow inherits Window {
    title: "Toloo";
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 320px;
    min-height: 480px;
    background: Theme.bg;

    in property <bool> has-identity: false;
    in property <string> identity-label: "No identity";
    in property <string> identity-initial: "?";
    in property <string> identity-avatar-path;
    in property <int> identity-avatar-palette: 0;
    in property <string> identity-sig-pub: "";
    in property <string> identity-enc-pub: "";
    in property <string> status: "Starting…";
    in property <string> network-label: "No relays";
    in property <string> active-room: "";
    in property <string> active-room-id: "";
    in property <string> room-key: "";
    in property <string> room-initial: "?";
    in property <string> room-avatar-path;
    in property <int> room-avatar-palette: 0;
    in property <bool> room-has-key: false;
    in property <string> members-label: "";
    in property <bool> rtl: false;
    in property <bool> notifications-enabled: false;
    in property <bool> warming: false;
    in property <string> export-text: "";
    in property <string> export-kind: "";
    in property <bool> host-running: false;
    in property <string> host-address: "";
    in property <int> host-connections: 0;
    in property <[RelayRow]> relays;
    in property <[BlockedRow]> blocked;
    in property <[RoomRow]> rooms;
    in property <[MessageRow]> messages;

    in-out property <string> search: "";
    in-out property <int> page: 0;
    in-out property <int> sheet: 0;
    in-out property <[int]> sheet-stack: [];
    in-out property <string> feedback-message: "";
    in-out property <bool> feedback-open: false;

    in-out property <string> relay-input: "";
    in-out property <string> create-room-name: "";
    in-out property <string> join-input: "";
    in-out property <string> sig-seed: "";
    in-out property <string> enc-priv: "";
    in-out property <string> import-input: "";
    in-out property <string> message-input: "";
    in-out property <bool> emoji-open: false;
    in-out property <int> focus-request: 0;
    in-out property <string> passphrase: "";
    in-out property <string> identity-input: "";
    in-out property <string> encrypted-input: "";
    in-out property <string> rename-input: "";
    in-out property <string> host-port: "17701";
    in-out property <string> host-proto: "ws";

    in-out property <string> selected-room-id: "";
    in-out property <string> selected-room-name: "";
    in-out property <bool> selected-room-has-key: false;

    callback create-identity();
    callback restore-identity(string, string);
    callback load-identity-json(string);
    callback export-identity();
    callback export-encrypted-identity(string);
    callback load-encrypted-identity(string, string);
    callback remove-identity();
    callback add-relay(string);
    callback remove-relay(string);
    callback create-room(string);
    callback join-room(string);
    callback select-room(string);
    callback search-changed(string);
    callback sync-now();
    callback sync-room(string);
    callback send-message(string);
    callback import-discovery(string);
    callback export-invite(string);
    callback export-messages(string);
    callback rename-room(string, string);
    callback leave-room(string);
    callback remove-room(string);
    callback delete-message(string, string);
    callback flag-message(string, string, string);
    callback block-node(string, string, string);
    callback unblock-node(string);
    callback attest-node(string, string);
    callback set-rtl(bool);
    callback set-notifications(bool);
    callback start-host(string, string);
    callback stop-host();
    callback copy-text(string);
    callback copy-selected([string]);
    callback delete-selected([string]);
    callback share-text(string);

    private property <bool> phone: root.width < 700px;
    private property <bool> tablet: root.width >= 700px && root.width < 1024px;
    private property <length> inset-left: root.safe-area-insets.left;
    private property <length> inset-top: root.safe-area-insets.top;
    private property <length> inset-right: root.safe-area-insets.right;
    private property <length> inset-bottom: root.safe-area-insets.bottom;
    private property <length> keyboard-height: root.virtual-keyboard-size.height > 0px
        ? root.virtual-keyboard-size.height : 0px;
    private property <length> last-keyboard-height: 0px;
    private property <length> emoji-panel-height: root.last-keyboard-height > 0px
        ? root.last-keyboard-height : 320px;
    private property <length> emoji-inset: root.emoji-open ? root.emoji-panel-height : 0px;
    private property <length> bottom-inset: max(root.inset-bottom,
        max(root.keyboard-height, root.emoji-inset));
    private property <length> content-height: root.height - root.inset-top
        - root.bottom-inset;
    private property <bool> can-back: root.feedback-open || root.sheet != 0
        || root.emoji-open || (root.phone && root.page == 1);
    private property <[string]> emojis: [
        "😀", "😂", "😊", "😍", "🤔", "😎", "😢", "😡",
        "👍", "👎", "🙏", "👏", "💪", "🤝", "👋", "❤️",
        "🔥", "✨", "🎉", "💯", "🌙", "☀️", "🌱", "🍀",
        "🍕", "☕", "🎵", "📎", "✅", "❌", "🔒", "🔗",
        "😅", "🤣", "🙂", "🙃", "😉", "😇", "🥰", "😘",
        "😋", "😜", "🤪", "🤗", "🤫", "🤭", "😴", "🤤",
        "🥳", "😏", "😒", "😞", "😔", "😟", "😕", "🙁",
        "😣", "😖", "😫", "😩", "🥺", "😭", "😤", "😠",
        "🤬", "😱", "😨", "😰", "😥", "😓", "🤯", "😳",
        "🥵", "🥶", "😵", "🤐", "🤢", "🤮", "🤧", "😷",
        "🤒", "🤕", "🤑", "🤠", "😈", "👿", "👻", "💀",
        "🤖", "💩", "😺", "😸", "😹", "😻", "😼", "😽"
    ];

    changed keyboard-height => {
        if (root.keyboard-height > 0px) {
            root.last-keyboard-height = root.keyboard-height;
        }
    }

    changed emoji-open => {
        if (root.emoji-open) {
            key-scope.focus();
        }
    }

    public function go-back() {
        if (root.feedback-open) {
            root.feedback-open = false;
        } else if (root.sheet != 0) {
            root.close-sheet();
        } else if (root.emoji-open) {
            root.emoji-open = false;
            root.focus-request += 1;
        } else if (root.phone && root.page == 1) {
            root.page = 0;
        }
    }

    public function open-sheet(next: int) {
        root.emoji-open = false;
        if (root.sheet != 0) {
            root.sheet-stack.push(root.sheet);
        }
        root.sheet = next;
    }

    public function close-sheet() {
        if (root.sheet-stack.length > 0) {
            root.sheet = root.sheet-stack[root.sheet-stack.length - 1];
            root.sheet-stack.remove(root.sheet-stack.length - 1);
        } else {
            root.sheet = 0;
        }
    }

    key-scope := FocusScope {
        width: 100%;
        height: 100%;
        init => { key-scope.focus(); }
        key-focus-timer := Timer {
            interval: 100ms;
            running: root.emoji-open && !key-scope.has-focus;
            triggered => { key-scope.focus(); }
        }
        KeyBinding {
            keys: @keys(Back);
            enabled: root.can-back;
            activated => { root.go-back(); }
        }
        KeyBinding {
            keys: @keys(Escape);
            enabled: root.can-back;
            activated => { root.go-back(); }
        }

        if root.phone && root.page == 0 : RoomsPane {
            x: root.inset-left;
            y: root.inset-top;
            width: root.width - root.inset-left - root.inset-right;
            height: root.content-height;
            rooms: root.rooms;
            identity-label: root.identity-label;
            identity-initial: root.identity-initial;
            identity-avatar-path: root.identity-avatar-path;
            identity-avatar-palette: root.identity-avatar-palette;
            status: root.status;
            network-label: root.network-label;
            compact: true;
            rtl: root.rtl;
            search <=> root.search;
            phone: true;
            select-room(id) => {
                root.emoji-open = false;
                root.select-room(id);
                root.page = 1;
            }
            sync-room(id) => { root.sync-room(id); }
            share-room(id) => {
                root.export-invite(id);
                root.open-sheet(4);
            }
            export-room(id) => {
                root.export-messages(id);
                root.open-sheet(4);
            }
            rename-room(id, name) => {
                root.selected-room-id = id;
                root.selected-room-name = name;
                root.open-sheet(6);
            }
            copy-text(value) => { root.copy-text(value); }
            leave-room(id) => { root.leave-room(id); }
            remove-room(id) => { root.remove-room(id); }
            search-changed(query) => { root.search-changed(query); }
            add-room => { root.open-sheet(1); }
            import-room => { root.open-sheet(2); }
            open-settings => { root.open-sheet(3); }
            open-relays => { root.open-sheet(3); }
        }

        if root.phone && root.page == 1 : ChatPane {
            x: root.inset-left;
            y: root.inset-top;
            width: root.width - root.inset-left - root.inset-right;
            height: root.content-height;
            messages: root.messages;
            room-name: root.active-room;
            room-id: root.room-key;
            room-id-full: root.active-room-id;
            room-initial: root.room-initial;
            room-has-key: root.room-has-key;
            room-avatar-path: root.room-avatar-path;
            room-avatar-palette: root.room-avatar-palette;
            members-label: root.members-label;
            status: root.status;
            has-room: root.active-room-id != "";
            show-back: true;
            rtl: root.rtl;
            message-input <=> root.message-input;
            emoji-open <=> root.emoji-open;
            focus-request <=> root.focus-request;
            back => {
                root.emoji-open = false;
                root.page = 0;
            }
            sync-room => { root.sync-now(); }
            share-room => {
                root.export-invite(root.active-room-id);
                root.open-sheet(4);
            }
            export-room => {
                root.export-messages(root.active-room-id);
                root.open-sheet(4);
            }
            open-settings => { root.open-sheet(3); }
            send-message(body) => { root.send-message(body); }
            copy-text(value) => { root.copy-text(value); }
            copy-selected(eids) => { root.copy-selected(eids); }
            delete-selected(eids) => { root.delete-selected(eids); }
            flag-message(room, target, category) => {
                root.flag-message(room, target, category);
            }
            block-node(node, kind, reason) => { root.block-node(node, kind, reason); }
            attest-node(target, level) => { root.attest-node(target, level); }
            delete-message(room, target) => {
                root.delete-message(room, target);
            }
            rename-room(id, name) => {
                root.selected-room-id = id;
                root.selected-room-name = name;
                root.open-sheet(6);
            }
            leave-room(id) => { root.leave-room(id); }
            remove-room(id) => { root.remove-room(id); }
        }

        if !root.phone : HorizontalLayout {
            x: root.inset-left;
            y: root.inset-top;
            width: root.width - root.inset-left - root.inset-right;
            height: root.height - root.inset-top
                - (root.emoji-open ? root.inset-bottom : root.bottom-inset);
            spacing: 0px;
            RoomsPane {
                width: root.tablet ? Theme.rail-width : Theme.sidebar-width;
                height: 100%;
                rooms: root.rooms;
                identity-label: root.identity-label;
                identity-initial: root.identity-initial;
                identity-avatar-path: root.identity-avatar-path;
                identity-avatar-palette: root.identity-avatar-palette;
                status: root.status;
                network-label: root.network-label;
                compact: root.tablet;
                rtl: root.rtl;
                search <=> root.search;
                select-room(id) => {
                    root.emoji-open = false;
                    root.select-room(id);
                }
                sync-room(id) => { root.sync-room(id); }
                share-room(id) => {
                    root.export-invite(id);
                    root.open-sheet(4);
                }
                export-room(id) => {
                    root.export-messages(id);
                    root.open-sheet(4);
                }
                rename-room(id, name) => {
                    root.selected-room-id = id;
                    root.selected-room-name = name;
                    root.open-sheet(6);
                }
                copy-text(value) => { root.copy-text(value); }
                leave-room(id) => { root.leave-room(id); }
                remove-room(id) => { root.remove-room(id); }
                search-changed(query) => { root.search-changed(query); }
                add-room => { root.open-sheet(1); }
                import-room => { root.open-sheet(2); }
                open-settings => { root.open-sheet(3); }
                open-relays => { root.open-sheet(3); }
            }
            Rectangle { width: 1px; height: 100%; background: Theme.border; }
            ChatPane {
                width: root.width - (root.tablet ? Theme.rail-width : Theme.sidebar-width) - 1px;
                height: parent.height - (root.emoji-open ? root.emoji-panel-height : 0px);
                messages: root.messages;
                room-name: root.active-room;
                room-id: root.room-key;
                room-id-full: root.active-room-id;
                room-initial: root.room-initial;
                room-has-key: root.room-has-key;
                room-avatar-path: root.room-avatar-path;
                room-avatar-palette: root.room-avatar-palette;
                members-label: root.members-label;
                status: root.status;
                has-room: root.active-room-id != "";
                show-back: false;
                rtl: root.rtl;
                message-input <=> root.message-input;
                emoji-open <=> root.emoji-open;
                focus-request <=> root.focus-request;
                back => { }
                sync-room => { root.sync-now(); }
                share-room => {
                    root.export-invite(root.active-room-id);
                    root.open-sheet(4);
                }
                export-room => {
                    root.export-messages(root.active-room-id);
                    root.open-sheet(4);
                }
                open-settings => { root.open-sheet(3); }
                send-message(body) => { root.send-message(body); }
                copy-text(value) => { root.copy-text(value); }
                copy-selected(eids) => { root.copy-selected(eids); }
                delete-selected(eids) => { root.delete-selected(eids); }
                flag-message(room, target, category) => {
                    root.flag-message(room, target, category);
                }
                block-node(node, kind, reason) => { root.block-node(node, kind, reason); }
                attest-node(target, level) => { root.attest-node(target, level); }
                delete-message(room, target) => {
                    root.delete-message(room, target);
                }
                rename-room(id, name) => {
                    root.selected-room-id = id;
                    root.selected-room-name = name;
                    root.open-sheet(6);
                }
                leave-room(id) => { root.leave-room(id); }
                remove-room(id) => { root.remove-room(id); }
            }
        }

        if root.emoji-open && root.active-room-id != ""
            && (!root.phone || root.page == 1) : Rectangle {
            x: root.phone
                ? root.inset-left
                : root.inset-left + (root.tablet ? Theme.rail-width : Theme.sidebar-width) + 1px;
            y: root.phone
                ? root.height - root.bottom-inset
                : root.height - root.inset-bottom - root.emoji-panel-height;
            width: root.phone
                ? root.width - root.inset-left - root.inset-right
                : root.width - root.inset-left - root.inset-right
                    - (root.tablet ? Theme.rail-width : Theme.sidebar-width) - 1px;
            height: root.phone ? root.bottom-inset : root.emoji-panel-height;
            background: Theme.bg;

            Rectangle {
                y: 0;
                width: 100%;
                height: 1px;
                background: Theme.border;
            }

            ScrollView {
                y: 1px;
                width: 100%;
                height: parent.height - 1px;
                vertical-scrollbar-policy: always-off;

                FlexboxLayout {
                    width: 100%;
                    padding: 8px;
                    spacing: 4px;
                    flex-wrap: wrap;
                    alignment: start;

                    for emoji in root.emojis : Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: Theme.radius-sm;
                        background: emoji-touch.pressed ? Theme.surface-2 : transparent;
                        Text {
                            text: emoji;
                            font-size: 21px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                        emoji-touch := TouchArea {
                            clicked => {
                                root.message-input = root.message-input + emoji;
                            }
                        }
                    }
                }
            }
        }

        if root.sheet != 0 : Rectangle {
            width: 100%;
            height: 100%;
            background: #00000099;

            TouchArea {
                clicked => { root.close-sheet(); }
            }

            Rectangle {
                width: root.phone
                    ? root.width - root.inset-left - root.inset-right
                    : Theme.settings-width;
                height: root.phone
                    ? root.content-height * 0.74
                    : 620px;
                x: root.phone
                    ? root.inset-left
                    : root.inset-left + (root.width - root.inset-left - root.inset-right - self.width) / 2;
                y: root.phone
                    ? root.height - root.bottom-inset - self.height
                    : root.inset-top + (root.height - root.inset-top - root.inset-bottom - self.height) / 2;
                border-radius: root.phone ? 16px : Theme.radius;
                background: Theme.surface;
                clip: true;

                if root.sheet == 1 : AddRoomSheet {
                    create-name <=> root.create-room-name;
                    join-input <=> root.join-input;
                    close => { root.close-sheet(); }
                    create-room(name) => {
                        root.create-room(name);
                        root.close-sheet();
                    }
                    join-room(value) => {
                        root.join-room(value);
                        root.close-sheet();
                    }
                }

                if root.sheet == 2 : ImportSheet {
                    import-input <=> root.import-input;
                    close => { root.close-sheet(); }
                    decode(value) => {
                        root.import-discovery(value);
                        root.close-sheet();
                    }
                }

                if root.sheet == 3 : SettingsSheet {
                    has-identity: root.has-identity;
                    identity-label: root.identity-label;
                    identity-initial: root.identity-initial;
                    identity-avatar-path: root.identity-avatar-path;
                identity-avatar-palette: root.identity-avatar-palette;
                    sig-pub: root.identity-sig-pub;
                    enc-pub: root.identity-enc-pub;
                    rtl: root.rtl;
                    notifications-enabled: root.notifications-enabled;
                    network-label: root.network-label;
                    host-running: root.host-running;
                    host-address: root.host-address;
                    host-connections: root.host-connections;
                    relays: root.relays;
                    blocked: root.blocked;
                    host-port <=> root.host-port;
                    host-proto <=> root.host-proto;
                    relay-input <=> root.relay-input;
                    sig-seed <=> root.sig-seed;
                    enc-priv <=> root.enc-priv;
                    passphrase <=> root.passphrase;
                    identity-input <=> root.identity-input;
                    encrypted-input <=> root.encrypted-input;
                    close => { root.close-sheet(); }
                    create-identity => { root.create-identity(); }
                    restore-identity(seed, key) => { root.restore-identity(seed, key); }
                    add-relay(url) => { root.add-relay(url); }
                    remove-relay(url) => { root.remove-relay(url); }
                    export-identity => {
                        root.export-identity();
                        root.open-sheet(4);
                    }
                    export-encrypted(passphrase) => {
                        root.export-encrypted-identity(passphrase);
                        root.open-sheet(4);
                    }
                    load-identity-json(json) => { root.load-identity-json(json); }
                    load-encrypted(blob, passphrase) => { root.load-encrypted-identity(blob, passphrase); }
                    remove-identity => { root.remove-identity(); }
                    unblock-node(node) => { root.unblock-node(node); }
                    set-rtl(enabled) => { root.set-rtl(enabled); }
                    set-notifications(enabled) => { root.set-notifications(enabled); }
                    start-host(port, proto) => { root.start-host(port, proto); }
                    stop-host => { root.stop-host(); }
                }

                if root.sheet == 4 : ExportSheet {
                    export-text: root.export-text;
                    export-kind: root.export-kind;
                    room-key: root.room-key;
                    close => { root.close-sheet(); }
                    copy(value) => { root.copy-text(value); }
                    share(value) => { root.share-text(value); }
                }

                if root.sheet == 6 : RenameSheet {
                    room-name: root.selected-room-name;
                    rename-name <=> root.rename-input;
                    close => { root.close-sheet(); }
                    rename(name) => {
                        root.rename-room(root.selected-room-id, name);
                        root.rename-input = "";
                        root.close-sheet();
                    }
                }
            }
        }
        if root.feedback-open : Rectangle {
            width: 100%;
            height: 100%;
            background: #00000099;

            TouchArea {
                clicked => { root.feedback-open = false; }
            }

            Rectangle {
                width: root.phone
                    ? root.width - root.inset-left - root.inset-right
                    : Theme.settings-width;
                height: root.phone ? 220px : 240px;
                x: root.phone
                    ? root.inset-left
                    : root.inset-left + (root.width - root.inset-left - root.inset-right - self.width) / 2;
                y: root.phone
                    ? root.height - root.inset-bottom - self.height
                    : root.inset-top + (root.height - root.inset-top - root.inset-bottom - self.height) / 2;
                border-radius: root.phone ? 16px : Theme.radius;
                background: Theme.surface;
                clip: true;

                AlertSheet {
                    message: root.feedback-message;
                    close => { root.feedback-open = false; }
                }
            }
        }
    }
}
