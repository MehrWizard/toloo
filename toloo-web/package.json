{
  "name": "toloo-web",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "design": "node ../design/generate.mjs",
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run design && npm run wasm && vite",
    "build": "npm run design && npm run wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.0.5"
  }
}
